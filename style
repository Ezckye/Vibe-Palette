* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', sans-serif;
    overflow: hidden; /* Prevents scrolling */
    height: 100vh;
    display: flex;
    flex-direction: column;
}

#palette {
    display: flex;
    height: 100%;
    width: 100%;
}

.color-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 50px;
    transition: background 0.5s ease; /* The smooth vibe transition */
    cursor: pointer;
}

.color-column h2 {
    color: white;
    text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    font-size: 1.5rem;
    text-transform: uppercase;
}

.controls {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.9);
    padding: 15px 30px;
    border-radius: 50px;
    display: flex;
    align-items: center;
    gap: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

button {
    padding: 10px 20px;
    border-radius: 20px;
    border: none;
    background: #000;
    color: #fff;
    cursor: pointer;
    font-weight: bold;
}
